{
  "name": "subscription-billing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "api": "node server.cjs",
    "build": "vite build",
    "lint": "eslint .",
    "start": "node server.cjs",
    "serve": "vite build && node server.cjs",
    "doctor": "node scripts/doctor.cjs",
    "hash-password": "node scripts/hash-password.cjs",
    "verify": "node scripts/test-auth.cjs && node scripts/test-privacy.cjs && node verify_accounting.cjs && python3 verify_rollover.py && node scripts/test-portability.cjs",
    "launchd:install": "node scripts/install-launchagent.cjs",
    "launchd:uninstall": "node scripts/uninstall-launchagent.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
