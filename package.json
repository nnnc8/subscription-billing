{
  "name": "subscription-billing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "api": "tsx server.ts",
    "build": "vite build",
    "lint": "eslint .",
    "start": "tsx server.ts",
    "serve": "vite build && tsx server.ts",
    "doctor": "node scripts/doctor.cjs",
    "verify": "node scripts/test-auth.cjs && node scripts/test-privacy.cjs && node verify_accounting.cjs && python3 verify_rollover.py && node scripts/test-portability.cjs",
    "test": "vitest run",
    "launchd:install": "node scripts/install-launchagent.cjs",
    "launchd:uninstall": "node scripts/uninstall-launchagent.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "express": "^5.2.1",
    "openai": "^6.42.0",
    "portkey-ai": "^3.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
