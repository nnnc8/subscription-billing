PORT=3000
HOST=127.0.0.1
DATA_DIR=.

# Required before exposing the app or deploying to Railway.
APP_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=your-account@gmail.com

# Optional. Set this if your public URL cannot be inferred correctly.
GOOGLE_REDIRECT_URI=

# Optional comma-separated list for production cross-origin callers.
ALLOWED_ORIGINS=
COOKIE_SECURE=

# Portkey AI Gateway configuration
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
PORTKEY_PROVIDER=google
PORTKEY_BASE_URL=https://api.portkey.ai/v1
AI_MODEL=gemini-3.1-flash-lite
AI_EMBEDDING_MODEL=text-embedding-004

