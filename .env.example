PORT=3000
HOST=127.0.0.1
DATA_DIR=.

# Required before exposing the app or deploying to Railway.
APP_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=your-account@gmail.com

# Optional. Set this if your public URL cannot be inferred correctly.
GOOGLE_REDIRECT_URI=

# Optional comma-separated list for production cross-origin callers.
ALLOWED_ORIGINS=
COOKIE_SECURE=
