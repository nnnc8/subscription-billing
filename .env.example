PORT=3000
HOST=127.0.0.1
DATA_DIR=.

# Required before exposing the app or running in production.
APP_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=your-account@gmail.com

# Exact public origin; production/cloud binding refuses to start without it.
PUBLIC_ORIGIN=

# Optional. Set this if your public URL cannot be inferred correctly.
GOOGLE_REDIRECT_URI=

# Optional comma-separated list for production cross-origin callers.
ALLOWED_ORIGINS=
# Optional trusted proxy CIDRs; forwarded headers are ignored by default.
TRUST_PROXY_CIDRS=
# Optional header the hosting proxy always overwrites with the client IP (Vercel: x-forwarded-for).
# Used only for rate limiting; leave empty when the app is reached directly.
CLIENT_IP_HEADER=
COOKIE_SECURE=

# Google Gemini AI configuration (required for AI features)
GOOGLE_GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-2

# Turso mode. Leave URL empty for local ${DATA_DIR}/database.db.
# On Vercel both values are required. Keep credentials in server environment variables.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel: NODE_ENV=production, COOKIE_SECURE=true, CLIENT_IP_HEADER=x-forwarded-for.
# PUBLIC_ORIGIN=https://<project>.vercel.app; do not use MIGRATE_FROM_JSON=1 there.
# Local bootstrap only: MIGRATE_FROM_JSON=1 imports database.json or the sanitized demo fixture
# into an empty database. Existing SQLite files are opened directly without this flag.
